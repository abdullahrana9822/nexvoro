# ---------------------------------------------------------------------------
# NEXVORO — environment variables
#
# Copy this file to `.env.local` for development, or add the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.
# Never commit real values. Nothing secret may use the NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# ===========================================================================
# DATABASE (Supabase PostgreSQL)
# ===========================================================================
# Runtime connection string. Use the Supabase *transaction pooler* for
# serverless (port 6543) — it keeps connection counts sane on Vercel.
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432). Required for migrations: the transaction
# pooler cannot run long DDL sessions. Falls back to DATABASE_URL when unset.
#   postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres"

# ===========================================================================
# SUPABASE STORAGE / AUTH
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ===========================================================================
# APPLICATION SECRETS
# ===========================================================================
# Required — 32+ byte random string used to sign sessions.
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-value"

# Required in production — public site origin (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required for the automated order lifecycle (Vercel Cron → /api/worker).
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-worker-token"

# ---------------------------------------------------------------------------
# Payments (optional)
# Online payment methods stay hidden and disabled until BOTH values are set.
# Cash on delivery and bank transfer always work.
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=""
PAYMENT_GATEWAY_SECRET=""

# ---------------------------------------------------------------------------
# Transactional email (optional)
# In-app notifications work without it. Password-reset links are displayed
# on-screen only when this is unset AND NODE_ENV is not production.
# ---------------------------------------------------------------------------
EMAIL_SERVICE_KEY=""

# ---------------------------------------------------------------------------
# Seeding only (scripts/seed.ts). Production deploys never run the seed.
# Passwords must be 10+ characters with upper/lower case and a number.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@nexvoro.com"
SEED_ADMIN_PASSWORD=""
SEED_STAFF_EMAIL="ops@nexvoro.com"
SEED_STAFF_PASSWORD=""
SEED_DEMO_EMAIL="customer@nexvoro.com"
SEED_DEMO_PASSWORD=""

# Temporary first Super Admin setup (disabled unless BOTH are configured).
# Generate locally with: node scripts/create-admin-setup.mjs
# Copy the printed digest/expiry to Vercel Production, redeploy, then use
# /admin-setup with the token from the PRIVATE generated file. Remove after use.
ADMIN_SETUP_TOKEN_SHA256=
ADMIN_SETUP_EXPIRES_AT=
