# ---------------------------------------------------------------------------
# NEXVORO — environment variables
#
# Copy this file to `.env.local` for development, or add the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.
# Never commit real values. Nothing secret may use the NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Required — PostgreSQL connection string (Neon, Supabase, RDS, Vercel Postgres).
# Local example: postgresql://nexvoro:nexvoro@127.0.0.1:5432/nexvoro
DATABASE_URL="postgresql://nexvoro:nexvoro@127.0.0.1:5432/nexvoro"

# Required — 32+ byte random string used to sign sessions.
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-value"

# Required in production — public site origin (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required for the automated order lifecycle.
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/worker.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-worker-token"

# ---------------------------------------------------------------------------
# Payments (optional)
# Online payment methods stay hidden and disabled until BOTH values are set.
# Cash on delivery and bank transfer always work.
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=""
PAYMENT_GATEWAY_SECRET=""

# ---------------------------------------------------------------------------
# Transactional email (optional)
# In-app notifications work without it; outbound email needs a provider key.
# ---------------------------------------------------------------------------
EMAIL_SERVICE_KEY=""

# ---------------------------------------------------------------------------
# Seeding only (scripts/seed.ts). Production deploys never run the seed.
# Passwords must be 10+ characters with upper/lower case and a number.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@nexvoro.com"
SEED_ADMIN_PASSWORD=""
SEED_STAFF_EMAIL="ops@nexvoro.com"
SEED_STAFF_PASSWORD=""
SEED_DEMO_EMAIL="customer@nexvoro.com"
SEED_DEMO_PASSWORD=""
