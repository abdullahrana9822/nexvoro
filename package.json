{
  "name": "nexvoro",
  "version": "1.0.0",
  "private": true,
  "description": "NEXVORO — premium electronics eCommerce platform",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "npm run db:deploy:if-configured && npm run db:seed:on-deploy && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "db:deploy": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "db:verify": "tsx --tsconfig tsconfig.scripts.json scripts/verify-supabase.ts",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx --tsconfig tsconfig.scripts.json scripts/worker.ts",
    "postinstall": "node -e \"process.exit(0)\"",
    "db:push": "drizzle-kit push",
    "test:integration": "vitest run tests/integration.test.ts",
    "vercel-build": "npm run build",
    "db:deploy:if-configured": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts --if-configured",
    "db:seed:on-deploy": "tsx --tsconfig tsconfig.scripts.json scripts/seed-if-configured.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "framer-motion": "14.10.1",
    "jose": "6.2.16",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.18.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
